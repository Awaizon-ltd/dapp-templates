# Awarizon API key — get one at https://awarizon.com/dashboard/api-keys
NEXT_PUBLIC_AWARIZON_API_KEY=awz_live_...

# WalletConnect project ID — get one at https://cloud.walletconnect.com
NEXT_PUBLIC_WC_PROJECT_ID=your_walletconnect_project_id

# Your app's public domain and URL (used in the SIWE message)
NEXT_PUBLIC_APP_DOMAIN=localhost
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Session encryption secret — generate with: openssl rand -hex 32
# Must be at least 32 characters
SESSION_SECRET=change_me_to_a_random_32_char_secret_value
