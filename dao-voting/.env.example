# Awarizon API key — get one at https://awarizon.com/dashboard/api-keys
NEXT_PUBLIC_AWARIZON_API_KEY=awz_live_...

# WalletConnect project ID — get one at https://cloud.walletconnect.com
NEXT_PUBLIC_WC_PROJECT_ID=your_walletconnect_project_id

# OpenZeppelin Governor contract address
NEXT_PUBLIC_GOVERNOR_ADDRESS=0x0000000000000000000000000000000000000000

# ERC-20 governance token address (for voting power display)
NEXT_PUBLIC_GOV_TOKEN_ADDRESS=0x0000000000000000000000000000000000000000
