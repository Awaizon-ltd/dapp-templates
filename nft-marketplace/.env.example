# Awarizon API key — get one at https://awarizon.com/dashboard/api-keys
NEXT_PUBLIC_AWARIZON_API_KEY=awz_live_...

# WalletConnect project ID — get one at https://cloud.walletconnect.com
NEXT_PUBLIC_WC_PROJECT_ID=your_walletconnect_project_id

# NFT collection contract address on Base
NEXT_PUBLIC_NFT_ADDRESS=0x0000000000000000000000000000000000000000

# Mint price in wei (0.01 ETH = 10000000000000000)
NEXT_PUBLIC_MINT_PRICE=10000000000000000

# Total supply / how many tokens to show in the gallery
NEXT_PUBLIC_TOTAL_SUPPLY=12
